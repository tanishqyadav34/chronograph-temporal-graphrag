[TEMPLATE]
# Groq API key for ChronoGraph triple extraction
# Get your key at https://console.groq.com
GROK_API_KEY=your_key_here

# Neo4j AuraDB connection (Task 3 — graph ingestion)
# Create a free AuraDB instance at https://console.neo4j.io
NEO4J_URI=bolt+s://your-db-id.databases.neo4j.io:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
